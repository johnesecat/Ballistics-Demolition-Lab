{
  "name": "breakwater-siege",
  "version": "1.0.0",
  "description": "BREAKWATER \u2014 an original pixel-art artillery destruction game for iPhone 15 Safari.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:walls && npm run test:fracture && npm run test:heat && npm run test:raster && npm run test:collision && npm run test:body && npm run test:projectile && npm run test:save && npm run test:deform",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "icons": "python3 scripts/extract_icons.py",
    "validate": "tsx scripts/validate-stages.ts",
    "test:walls": "tsx scripts/test-walls.ts",
    "test:fracture": "tsx scripts/test-fracture.ts",
    "test:heat": "tsx scripts/test-heat-anchor.ts",
    "test:raster": "tsx scripts/test-pixel-runs.ts",
    "test:collision": "tsx scripts/test-collision.ts",
    "test:softbody": "tsx scripts/test-soft-body.ts",
    "test:projectile": "tsx scripts/test-projectile.ts",
    "test:save": "tsx scripts/test-save.ts",
    "test:deform": "tsx scripts/test-deform.ts",
    "sample-round": "tsx scripts/render_round.ts && python3 scripts/sample_projectile.py",
    "bench:body": "tsx scripts/bench-body.ts",
    "test:body": "tsx scripts/test-body.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}